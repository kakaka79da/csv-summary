{
  "name": "guild-office",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "글로벌 MMO형 AI-휴먼 협업 오피스 — MVP 프로토타입",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",

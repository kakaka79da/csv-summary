# 실제 비밀값은 이 파일에 넣지 않는다. 이름과 형식만 기록한다.
# 배포 시 서버 환경변수로만 주입하고, 클라이언트 번들에는 절대 포함하지 않는다.

# 관리자 최초 1회용 임시 암호. 최초 로그인 직후 변경을 강제하고 즉시 폐기한다.
BOOTSTRAP_ADMIN_PASSWORD=replace-at-deployment

# 세션/토큰 서명용 시크릿.
AUTH_SECRET=replace-at-deployment

# 아래는 백엔드 도입 단계에서 사용할 예시 이름이다. (프로토타입에서는 사용하지 않는다)
DATABASE_URL=replace-at-deployment
# AI 제공자 키는 서버에서만 보관하며, 프론트엔드는 keyRef(참조 ID)만 다룬다.
PROVIDER_KEY_ENCRYPTION_KEY=replace-at-deployment
